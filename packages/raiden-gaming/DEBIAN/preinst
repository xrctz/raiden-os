#!/bin/sh
set -e
# Debian's Steam package calls its launcher "Install Steam" until Steam has
# started once (Valve's own launcher, named "Steam", takes over then). Show
# Valve's launcher from the start: ours replaces Debian's, which is kept aside.
if [ "$1" = install ] || [ "$1" = upgrade ]; then
    mkdir -p /usr/share/raiden-gaming
    dpkg-divert --package raiden-gaming --add --rename \
        --divert /usr/share/raiden-gaming/steam.desktop.debian \
        /usr/share/applications/steam.desktop
fi
exit 0
