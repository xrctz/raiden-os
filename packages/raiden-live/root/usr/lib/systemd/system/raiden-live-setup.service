[Unit]
Description=Prepare the @DISTRO_NAME@ live session
ConditionKernelCommandLine=boot=casper
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service
Before=display-manager.service systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/raiden-live/live-setup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
