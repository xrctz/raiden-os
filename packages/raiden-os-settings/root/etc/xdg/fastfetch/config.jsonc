// @DISTRO_NAME@ system-wide fastfetch configuration.
// Copy it to ~/.config/fastfetch/config.jsonc to customise it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/raiden-os/fastfetch/logo.ansi",
    "width": 30,
    "height": 15,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "color": { "keys": "blue" },
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "de",
    "wm",
    "display",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "break",
    "colors"
  ]
}
