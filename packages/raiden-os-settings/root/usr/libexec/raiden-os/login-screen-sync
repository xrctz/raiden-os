#!/usr/bin/python3
"""Keep the login screen in step with the session of the person at the
computer. Run through pkexec by display-setup; polkit allows it without a
password for the active session, like choosing a refresh rate in Settings.

    login-screen-sync monitors < monitors.xml
        the login screen uses this display configuration (the same layout
        and refresh rates as the session)
    login-screen-sync wallpaper ultrawide|normal
        the login screen picture switches to its ultrawide version, or back

GDM 50 runs the login screen as a temporary user whose settings live in
/var/lib/gdm3/<seat>/config, and it does not run autostart programs there, so
the session hands its configuration over instead.
"""
import glob
import os
import re
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET

GDM_DIR = "/var/lib/gdm3"
LOGIN_CONF = "/etc/gdm3/raiden-login-background"
BACKGROUNDS = "/usr/share/backgrounds/"
MAX_SIZE = 256 * 1024
# everything mutter writes to a user's monitors.xml (no system policy)
MONITOR_TAGS = {
    "monitors", "configuration", "layoutmode", "disabled", "logicalmonitor", "x", "y",
    "scale", "transform", "rotation", "flipped", "primary", "presentation", "monitor",
    "monitorspec", "connector", "vendor", "product", "serial", "mode", "width", "height",
    "rate", "flag", "refreshratemode", "underscanning", "maxbpc", "colormode", "rgbrange",
}


def fail(msg):
    print(f"login-screen-sync: {msg}", file=sys.stderr)
    sys.exit(1)


def write_file(path, data, uid=0, gid=0):
    """Replace PATH atomically (never through a symlink placed there)."""
    folder = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".raiden-")
    try:
        os.write(fd, data)
        os.fchown(fd, uid, gid)
        os.fchmod(fd, 0o644)
        os.fsync(fd)
        os.close(fd)
        os.rename(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def monitors():
    data = sys.stdin.buffer.read(MAX_SIZE + 1)
    if len(data) > MAX_SIZE:
        fail("configuration too large")
    if b"<!" in data:                    # no DOCTYPE, entities or the like
        fail("unexpected markup")
    try:
        root = ET.fromstring(data)
    except ET.ParseError as exc:
        fail(f"not a monitor configuration: {exc}")
    if root.tag != "monitors" or any(el.tag not in MONITOR_TAGS for el in root.iter()):
        fail("not a monitor configuration")
    seats = [d for d in glob.glob(os.path.join(GDM_DIR, "*", "config")) if os.path.isdir(d)]
    if not seats:
        fail("no login screen configuration folder yet")
    for folder in seats:
        st = os.stat(folder)
        write_file(os.path.join(folder, "monitors.xml"), data, st.st_uid, st.st_gid)


def wallpaper(kind):
    try:
        with open(LOGIN_CONF, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return                                   # no @DISTRO_NAME@ login picture
    m = re.search(r"^background-picture-uri='file://([^']+)'$", text, re.M)
    if not m:
        return
    path = m.group(1)
    root, ext = os.path.splitext(path)
    if root.endswith("-ultrawide"):
        root = root[:-len("-ultrawide")]
    target = f"{root}-ultrawide{ext}" if kind == "ultrawide" else root + ext
    real = os.path.realpath(target)
    if target == path or not real.startswith(BACKGROUNDS) or not os.path.isfile(real):
        return
    write_file(LOGIN_CONF, text.replace(f"file://{path}'", f"file://{target}'").encode())
    subprocess.run(["/usr/share/gdm/generate-config"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    if len(sys.argv) == 2 and sys.argv[1] == "monitors":
        monitors()
    elif len(sys.argv) == 3 and sys.argv[1] == "wallpaper" and sys.argv[2] in ("ultrawide", "normal"):
        wallpaper(sys.argv[2])
    else:
        fail("usage: login-screen-sync monitors < monitors.xml | wallpaper ultrawide|normal")


if __name__ == "__main__":
    main()
