<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>@DISTRO_NAME@</vendor>
  <action id="org.raidenos.login-screen-sync">
    <description>Use your display settings on the login screen</description>
    <message>Authentication is required to change the login screen's display settings</message>
    <icon_name>preferences-desktop-display</icon_name>
    <defaults>
      <!-- like choosing a refresh rate: free for the person at the computer -->
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/raiden-os/login-screen-sync</annotate>
  </action>
</policyconfig>
