[Unit]
Description=Install missing apps and new releases of Antigravity, ProtonPlus and Heroic

[Timer]
# Soon after every start (apps missing from the ISO arrive as soon as the
# computer is online; NetworkManager also starts it when it goes online), then
# every day it stays on
OnBootSec=1min
OnUnitActiveSec=1d
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
