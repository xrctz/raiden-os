#!/bin/sh
# Set the login screen (GDM) background picture.
#
#   set-login-background /usr/share/backgrounds/FILE   use that system wallpaper
#   set-login-background --default                     plain background
#
# Runs as root through pkexec (polkit action
# org.raidenos.appearance.login-background). Only pictures under
# /usr/share/backgrounds are accepted: the greeter cannot read home folders,
# and this keeps the helper from touching arbitrary files.
set -eu
CONF=/etc/gdm3/raiden-login-background

case "${1:-}" in
    --default)
        uri="" ;;
    /*)
        f="$(readlink -f -- "$1")" || exit 2
        case "$f" in
            /usr/share/backgrounds/*.jpg|/usr/share/backgrounds/*.jpeg|/usr/share/backgrounds/*.png|/usr/share/backgrounds/*.webp) ;;
            *) echo "not a picture under /usr/share/backgrounds: $1" >&2; exit 2 ;;
        esac
        [ -f "$f" ] || { echo "no such file: $f" >&2; exit 2; }
        case "$f" in *"'"*|*'\'*) echo "unsupported file name: $f" >&2; exit 2 ;; esac
        uri="file://$f" ;;
    *)
        echo "usage: $0 /usr/share/backgrounds/FILE | --default" >&2
        exit 2 ;;
esac

tmp="$(mktemp "$CONF.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
{
    echo "# @DISTRO_NAME@ login screen background. Appearance -> Characters rewrites"
    echo "# this file through /usr/libexec/raiden-appearance/set-login-background."
    echo "[com/ubuntu/login-screen]"
    if [ -n "$uri" ]; then
        echo "background-picture-uri='$uri'"
        echo "background-size='cover'"
        echo "background-repeat='no-repeat'"
        echo "background-color='#05030a'"
    fi
} > "$tmp"
chmod 644 "$tmp"
mv -f "$tmp" "$CONF"
trap - EXIT
# recompile the greeter settings (as Ubuntu's gdm3 package does)
exec /usr/share/gdm/generate-config
