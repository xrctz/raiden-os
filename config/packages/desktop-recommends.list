# Recommends of the raiden-desktop metapackage: apps and extras.
# Installed by default, but users may remove any of them without losing the
# metapackage (which is what keeps future updates complete).

# Apps
# Google Chrome (Google's own repository; replaces Firefox, see README)
google-chrome-stable
ptyxis
gnome-text-editor
loupe
papers
showtime
rhythmbox
gnome-calculator
gnome-calendar
gnome-weather
gnome-clocks
gnome-characters
gnome-font-viewer
gnome-snapshot
simple-scan
baobab
gnome-disk-utility
gnome-logs
resources
seahorse
file-roller
deja-dup
timeshift
gnome-tweaks
gnome-shell-extension-manager
gnome-shell-extension-prefs
gnome-shell-extension-gsconnect
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-gnome
libreoffice-style-colibre
libreoffice-draw

# School and work: PDF notes and handwriting, e-books; Office-compatible fonts
# (Carlito and Caladea have Calibri's and Cambria's metrics, so documents
# from Microsoft Word keep their layout). Outlook and Microsoft 365 are web
# apps from raiden-apps.
xournalpp
foliate
fonts-crosextra-carlito
fonts-crosextra-caladea

# AI: Claude (Anthropic's repository). Antigravity and Antigravity IDE come
# with raiden-apps.
claude-desktop

# Games: Steam, Heroic (Epic, GOG, Amazon; the image build adds its .deb),
# Lutris, ProtonPlus (raiden-apps); FPS overlay, upscaling and system tuning
steam-installer
steam-devices
heroic
lutris
mangohud
goverlay
gamescope
raiden-gaming
raiden-apps
vulkan-tools
mesa-utils
